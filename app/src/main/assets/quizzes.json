            {
              "id": 1,
              "question_text": "Which sentence is correct?",
              "options": [
                "I am agree with you.",
                "I agree with you.",
                "I am agreeing with you.",
                "I agreeing with you."
              ],
              "correct_answer_index": 1,
              "explanation_bn": "'Agree' একটি verb। তাই present tense-এ এর আগে 'am' লাগে না।",
              "example_sentence": "I agree with your decision."
            },
            {
              "id": 2,
              "question_text": "Identify the correct sentence:",
              "options": [
                "He does not knows me.",
                "He does not know me.",
                "He not know me.",
                "He do not know me."
              ],
              "correct_answer_index": 1,
              "explanation_bn": "Does/Do এর পর verb এর base form বসে, s/es যুক্ত হয় না।",
              "example_sentence": "She does not like tea."
            },
            {
              "id": 3,
              "question_text": "Which one is right?",
              "options": [
                "I have seen him yesterday.",
                "I saw him yesterday.",
                "I was saw him yesterday.",
                "I see him yesterday."
              ],
              "correct_answer_index": 1,
              "explanation_bn": "'Yesterday' থাকলে past indefinite tense (saw) হয়, present perfect (have seen) নয়।",
              "example_sentence": "I saw a movie yesterday."
            }
          ]
        }
